{
  "name": "project-jezza-hunter-valley-legends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PROJECT JEZZA: HUNTER VALLEY LEGENDS — mobile-first multiplayer bucks-weekend party game",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server/index.js --packages=external",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:multiplayer": "tsx tests/multiplayer.sim.ts",
    "test:viewports": "tsx tests/viewports.ts",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "engines": { "node": ">=22" }
}
