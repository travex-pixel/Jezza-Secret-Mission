# Port for the game server (serves API, WebSocket and the built client)
PORT=8787
# Where party state + photos are persisted (created automatically)
DATA_DIR=./data
# Optional: public URL for link previews (defaults to whatever address the visitor used)
# PUBLIC_URL=https://jezza.example.com
# Build-time only: absolute public URL (no trailing slash) used for link-preview images, e.g. https://jezza.fly.dev
# VITE_PUBLIC_URL=https://jezza.example.com
